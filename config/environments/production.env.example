APP_ENV=production
DEPLOY_TARGET=remote
CLIENT_CODE=cliente-demo
DATABASE_URL=postgresql://user:password@host:5432/dbname
API_BASE_URL=https://api.cliente.com
WEB_BASE_URL=https://app.cliente.com
CORS_ALLOWED_ORIGINS=https://app.cliente.com
JWT_SECRET=replace-with-secret-manager-value
STORAGE_BACKEND=s3
FILE_STORAGE_BUCKET=cliente-files
LOG_LEVEL=info
